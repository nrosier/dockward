# Dockward environment. Copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never commit a real `.env` or paste real keys here.

# Required. The base64 encoding of exactly 32 random bytes. Generate one with:
#   openssl rand -base64 32
# Losing this key makes stored credentials unrecoverable. Back it up separately.
DOCKWARD_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Required. The external origin users open. Must be https://, except
# http://localhost (any port) for local development only.
DOCKWARD_PUBLIC_URL=https://dockward.example.com

# Optional. Comma-separated CIDRs of reverse proxies whose X-Forwarded-For
# header is trusted. Empty by default.
DOCKWARD_TRUSTED_PROXIES=

# Optional. Data and backup directories. Defaults: /data and /data/backups.
DOCKWARD_DATA_DIR=/data
DOCKWARD_BACKUP_DIR=/data/backups

# Optional outbound address opt-outs. All default to false. Leave them false
# unless a Harbor, OIDC provider or alert target is on a private address.
DOCKWARD_ALLOW_PRIVATE_HARBOR=false
DOCKWARD_ALLOW_PRIVATE_OIDC=false
DOCKWARD_ALLOW_PRIVATE_ALERTS=false

# Only for `dockward rotate-key`. Set it from your shell, not in this file.
# DOCKWARD_OLD_ENCRYPTION_KEY=
