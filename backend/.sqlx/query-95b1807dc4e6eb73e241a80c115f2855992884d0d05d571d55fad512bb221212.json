  "query": "SELECT l.id AS \"id!\", s.seq AS \"step_seq!: i64\", l.at AS \"at!: i64\",\n                  l.stream AS \"stream!\", l.text AS \"text!\"\n           FROM job_log_lines l\n           JOIN job_log_steps s ON s.id = l.step_id\n           WHERE s.job_id = ? AND s.attempt = ? AND l.id > ?\n           ORDER BY l.id ASC\n           LIMIT ?",
