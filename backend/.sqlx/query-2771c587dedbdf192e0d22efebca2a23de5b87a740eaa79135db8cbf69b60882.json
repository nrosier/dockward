  "query": "SELECT cve_id AS \"cve_id!\", image_tag AS \"image_tag!\", package,\n                  severity AS \"severity!\", fixed_in_version, status AS \"status!\", last_seen_at,\n                  description\n           FROM cve_findings\n           WHERE source_id = ?1\n             AND (cve_id = ?2\n                  OR cve_id IN (SELECT alias FROM vulnerability_aliases WHERE primary_id = ?2))\n           ORDER BY image_tag",
